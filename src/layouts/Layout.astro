---
import '../styles/global.css';
import { projects } from '../data/projects';
import ThemeToggle from '../components/ThemeToggle.tsx';

interface Props {
  title: string;
  description?: string;
  lang: 'pl' | 'en';
  currentPage: string;
  canonicalUrl?: string;
}

const { title, description, lang, currentPage, canonicalUrl } = Astro.props;
const siteUrl = 'https://aszlaczek.github.io/portfolio';
const pageUrl = canonicalUrl ? `${siteUrl}${canonicalUrl}` : `${siteUrl}/${lang === 'en' ? 'en/' : ''}`;
const pageTitle = title ? `${title} | Adrian Wzorek` : 'Adrian Wzorek — Full Stack Web Developer';
const pageDescription = description || 'Full Stack Web Developer — TypeScript, React, Next.js, Node.js. Portfolio, projects, experience and contact.';

const navItems = {
  pl: [
    { href: '#home', label: 'Główna' },
    { href: '#about', label: 'O mnie' },
    { href: '#experience', label: 'Doświadczenie' },
    { href: '#projects', label: 'Projekty' },
    { href: '#skills', label: 'Umiejętności' },
    { href: '#education', label: 'Edukacja' },
    { href: '#contact', label: 'Kontakt' }
  ],
  en: [
    { href: '#home', label: 'Home' },
    { href: '#about', label: 'About' },
    { href: '#experience', label: 'Experience' },
    { href: '#projects', label: 'Projects' },
    { href: '#skills', label: 'Skills' },
    { href: '#education', label: 'Education' },
    { href: '#contact', label: 'Contact' }
  ]
};

const currentNav = navItems[lang];
const otherLang = lang === 'pl' ? 'en' : 'pl';
const otherLangLabel = lang === 'pl' ? 'EN' : 'PL';
const otherLangHref = currentPage === 'index' 
  ? `/portfolio/${otherLang}/` 
  : `/portfolio/${otherLang}/projects/${currentPage.replace('.astro', '').replace('_en', '')}/`;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={pageUrl} />
    <link rel="alternate" hreflang="pl" href={`${siteUrl}/`} />
    <link rel="alternate" hreflang="en" href={`${siteUrl}/en/`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}/`} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#4F46E5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#818CF8" media="(prefers-color-scheme: dark)" />
    
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="Adrian Wzorek — Portfolio" />
    <meta property="og:locale" content={lang === 'pl' ? 'pl_PL' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'pl' ? 'en_US' : 'pl_PL'} />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/portfolio/favicon.svg" />
  </head>
  <body class="min-h-screen flex flex-col">
    <!-- Navigation -->
    <nav class="fixed top-0 left-0 right-0 z-50 bg-[var(--bg)]/90 backdrop-blur-md border-b border-[var(--border)]" aria-label={lang === 'pl' ? 'Główna nawigacja' : 'Main navigation'}>
      <div class="container mx-auto px-4">
        <div class="flex items-center justify-between h-16">
          <!-- Logo -->
          <a href={lang === 'pl' ? '/portfolio/' : '/portfolio/en/'} class="text-xl font-display font-bold" aria-label={lang === 'pl' ? 'Adrian Wzorek - Strona główna' : 'Adrian Wzorek - Home'}>
            Adrian Wzorek
          </a>
          
          <!-- Desktop Navigation -->
          <div class="hidden md:flex items-center gap-8">
            {currentNav.map(item => (
              <a href={item.href} class="text-sm font-medium transition-colors hover:text-[var(--accent)]" aria-current={currentPage === 'index' && item.href === '#home' ? 'page' : undefined}>
                {item.label}
              </a>
            ))}
            
            <!-- Language Toggle -->
            <a href={otherLangHref} class="px-3 py-1.5 text-sm font-medium rounded-lg border border-[var(--border)] bg-[var(--card)] hover:bg-[var(--border)] transition-colors">
              {otherLangLabel}
            </a>
            
            <!-- Theme Toggle -->
            <ThemeToggle client:visible />
          </div>
          
          <!-- Mobile Menu Button -->
          <button class="md:hidden p-2 rounded-lg border border-[var(--border)] bg-[var(--card)]" aria-expanded="false" aria-controls="mobile-menu" aria-label={lang === 'pl' ? 'Otwórz menu' : 'Open menu'}>
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
        
        <!-- Mobile Menu -->
        <div id="mobile-menu" class="md:hidden overflow-hidden transition-all duration-300 max-h-0" hidden>
          <div class="py-4 space-y-3 border-t border-[var(--border)]">
            {currentNav.map(item => (
              <a href={item.href} class="block px-2 py-2 text-base font-medium rounded-lg hover:bg-[var(--border)] transition-colors" aria-current={currentPage === 'index' && item.href === '#home' ? 'page' : undefined}>
                {item.label}
              </a>
            ))}
            <div class="flex items-center gap-3 pt-3 border-t border-[var(--border)]">
              <a href={otherLangHref} class="px-3 py-1.5 text-sm font-medium rounded-lg border border-[var(--border)] bg-[var(--card)] hover:bg-[var(--border)] transition-colors flex-1 text-center">
                {otherLangLabel}
              </a>
              <ThemeToggle client:visible />
            </div>
          </div>
        </div>
      </div>
    </nav>
    
    <!-- Main Content -->
    <main id="main-content" class="flex-1 pt-16">
      <slot />
    </main>
    
    <!-- Footer -->
    <footer class="bg-[var(--card)] border-t border-[var(--border)]" role="contentinfo">
      <div class="container mx-auto px-4 py-8">
        <div class="flex flex-col md:flex-row items-center justify-between gap-4">
          <div class="text-center md:text-left">
            <p class="text-sm text-[var(--text)]/70">
              {lang === 'pl' ? 'Ilustracje:' : 'Illustrations:'} 
              <a href="https://www.pictographic.io/" target="_blank" rel="noopener noreferrer" class="underline hover:text-[var(--accent)]">Pictographic</a>
            </p>
            <p class="text-sm text-[var(--text)]/50 mt-1">
              © {new Date().getFullYear()} Adrian Wzorek. {lang === 'pl' ? 'Wszelkie prawa zastrzeżone.' : 'All rights reserved.'}
            </p>
          </div>
          
          <div class="flex items-center gap-6">
            <a href="https://www.linkedin.com/in/adrian-wzorek-902572309/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="text-[var(--text)]/60 hover:text-[var(--accent)] transition-colors">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </a>
            <a href="https://github.com/aszlaczek" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="text-[var(--text)]/60 hover:text-[var(--accent)] transition-colors">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z" fill-rule="evenodd"/>
              </svg>
            </a>
          </div>
</div>
      </div>
    </footer>
    
    <!-- Mobile Menu Script -->
    <script>
      const menuBtn = document.querySelector('button[aria-controls="mobile-menu"]');
      const mobileMenu = document.getElementById('mobile-menu');
      
      if (menuBtn && mobileMenu) {
        menuBtn.addEventListener('click', () => {
          const isOpen = mobileMenu.hidden;
          mobileMenu.hidden = !isOpen;
          menuBtn.setAttribute('aria-expanded', isOpen);
          if (isOpen) {
            mobileMenu.style.maxHeight = mobileMenu.scrollHeight + 'px';
          } else {
            mobileMenu.style.maxHeight = '0';
          }
        });
        
        // Close menu on link click
        mobileMenu.querySelectorAll('a').forEach(link => {
          link.addEventListener('click', () => {
            mobileMenu.hidden = true;
            menuBtn.setAttribute('aria-expanded', 'false');
            mobileMenu.style.maxHeight = '0';
          });
        });
      }
    </script>
    
    <!-- Theme Toggle Script (fallback for no-JS) -->
    <script is:inline>
      // Initialize theme from localStorage or system preference
      (function() {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const isDark = stored ? stored === 'dark' : prefersDark;
        document.documentElement.classList.toggle('dark', isDark);
      })();
    </script>
  </body>
</html>