---
import Layout from '../layouts/Layout.astro';
import FadeIn from '../components/FadeIn.tsx';
---

<Layout title="404 — Page Not Found" description="Page not found" lang="en" currentPage="404_en">
  <div class="min-h-[calc(100vh-200px)] flex items-center justify-center px-4">
    <FadeIn class="text-center max-w-md">
      <h1 class="text-8xl md:text-9xl font-display font-bold text-[var(--accent)]/20 mb-4">404</h1>
      <h2 class="text-2xl md:text-3xl font-display font-bold mb-4">Page Not Found</h2>
      <p class="text-[var(--text)]/70 mb-8">Sorry, but the page you're looking for doesn't exist or has been moved.</p>
      <a href="/portfolio/en/" class="btn btn-primary inline-flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Back to Home
      </a>
    </FadeIn>
  </div>
</Layout>