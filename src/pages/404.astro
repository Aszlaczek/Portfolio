---
import Layout from '../layouts/Layout.astro';
import FadeIn from '../components/FadeIn.tsx';
---

<Layout title="404 — Strona nie znaleziona" description="Strona nie została znaleziona" lang="pl" currentPage="404">
  <div class="min-h-[calc(100vh-200px)] flex items-center justify-center px-4">
    <FadeIn class="text-center max-w-md">
      <h1 class="text-8xl md:text-9xl font-display font-bold text-[var(--accent)]/20 mb-4">404</h1>
      <h2 class="text-2xl md:text-3xl font-display font-bold mb-4">Strona nie znaleziona</h2>
      <p class="text-[var(--text)]/70 mb-8">Przepraszamy, ale strona, której szukasz, nie istnieje lub została przeniesiona.</p>
      <a href="/portfolio/" class="btn btn-primary inline-flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Wróć na stronę główną
      </a>
    </FadeIn>
  </div>
</Layout>