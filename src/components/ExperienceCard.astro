---
interface Props {
  experience: {
    id: string;
    title: { pl: string; en: string };
    company: string;
    period: { pl: string; en: string };
    description: { pl: string; en: string };
    achievements: { pl: string; en: string }[];
    technologies: string[];
  };
  lang: 'pl' | 'en';
}

const { experience, lang } = Astro.props;
const t = experience;
---

<article class="card p-6 md:p-8 relative overflow-hidden group" aria-labelledby={`exp-${experience.id}-title`}>
  <!-- Timeline dot -->
  <div class="absolute left-0 top-6 w-4 h-4 rounded-full bg-[var(--accent)] border-4 border-[var(--bg)] -translate-x-1/2" aria-hidden="true"></div>
  <div class="absolute left-0 top-10 bottom-0 w-0.5 bg-[var(--border)] -translate-x-1/2" aria-hidden="true"></div>
  
  <div class="pl-6 md:pl-8">
    <header class="mb-4">
      <h3 id={`exp-${experience.id}-title`} class="font-display font-semibold text-xl text-[var(--accent)]">
        {t.title[lang]}
      </h3>
      <p class="text-[var(--text)]/70 font-medium mt-1">{t.company}</p>
      <p class="text-[var(--text)]/50 text-sm mt-0.5">{t.period[lang]}</p>
    </header>
    
    <p class="text-[var(--text)]/80 mb-4 leading-relaxed">{t.description[lang]}</p>
    
    <!-- Achievements -->
    <ul class="space-y-2 mb-4" role="list">
      {t.achievements.map(achievement => (
        <li class="flex items-start gap-2 text-[var(--text)]/70">
          <svg class="w-5 h-5 flex-shrink-0 text-[var(--accent)] mt-0.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
          <span>{achievement[lang]}</span>
        </li>
      ))}
    </ul>
    
    <!-- Technologies -->
    <div class="flex flex-wrap gap-2" aria-label={lang === 'pl' ? 'Technologie' : 'Technologies'}>
      {t.technologies.map(tech => (
        <span class="chip text-xs" key={tech}>{tech}</span>
      ))}
    </div>
  </div>
</article>