---
import FadeIn from './FadeIn.tsx';
import { education } from '../data/experience';

interface Props {
  lang: 'pl' | 'en';
}

const { lang } = Astro.props;

const title = { pl: 'Edukacja', en: 'Education' };
const subtitle = {
  pl: 'Moje wykształcenie akademickie',
  en: 'My academic background'
};
---

<section id="education" class="section" aria-labelledby="education-title">
  <div class="container mx-auto px-4">
    <FadeIn class="max-w-3xl mx-auto text-center">
      <h2 id="education-title" class="section-title">{title[lang]}</h2>
      <p class="text-[var(--text)]/60 mt-2">{subtitle[lang]}</p>
    </FadeIn>
    
    <div class="max-w-2xl mx-auto mt-12 space-y-6">
      {education.map((edu, index) => (
        <FadeIn delay={index * 150} key={edu.id}>
          <article class="card p-6 md:p-8 relative overflow-hidden group">
            <!-- Timeline dot -->
            <div class="absolute left-0 top-6 w-4 h-4 rounded-full bg-[var(--accent)] border-4 border-[var(--bg)] -translate-x-1/2" aria-hidden="true"></div>
            <div class="absolute left-0 top-10 bottom-0 w-0.5 bg-[var(--border)] -translate-x-1/2 last:hidden" aria-hidden="true"></div>
            
            <div class="pl-6 md:pl-8">
              <header class="mb-3">
                <h3 class="font-display font-semibold text-xl text-[var(--accent)]">
                  {edu.degree[lang]}
                </h3>
                <p class="text-[var(--text)]/70 font-medium mt-1">{edu.field[lang]}</p>
              </header>
              
              <div class="flex items-center gap-3 text-[var(--text)]/60 text-sm">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                </svg>
                <span>{edu.institution}</span>
              </div>
              
              <div class="flex items-center gap-3 text-[var(--text)]/60 text-sm mt-1">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>{edu.period[lang]}</span>
              </div>
              
              {edu.details && (
                <p class="text-[var(--text)]/50 text-sm mt-3">{edu.details[lang]}</p>
              )}
            </div>
          </article>
        </FadeIn>
      ))}
    </div>
  </div>
</section>