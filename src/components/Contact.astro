---
import FadeIn from './FadeIn.tsx';

interface Props {
  lang: 'pl' | 'en';
}

const { lang } = Astro.props;

const title = { pl: 'Kontakt', en: 'Contact' };
const subtitle = {
  pl: 'Chcesz porozmawiać o projekcie? Napisz do mnie',
  en: 'Want to talk about a project? Get in touch'
};
const emailLabel = { pl: 'Email', en: 'Email' };
const linkedinLabel = { pl: 'LinkedIn', en: 'LinkedIn' };
const githubLabel = { pl: 'GitHub', en: 'GitHub' };
const cvLabel = { pl: 'Pobierz CV (PDF)', en: 'Download CV (PDF)' };
const cvDesc = { pl: 'Aktualne CV w języku polskim', en: 'Current CV in Polish' };
const writeToMe = { pl: 'Napisz do mnie', en: 'Write to me' };
const or = { pl: 'lub', en: 'or' };
---

<section id="contact" class="section" aria-labelledby="contact-title">
  <div class="container mx-auto px-4">
    <FadeIn class="max-w-3xl mx-auto text-center">
      <h2 id="contact-title" class="section-title">{title[lang]}</h2>
      <p class="text-[var(--text)]/60 mt-2">{subtitle[lang]}</p>
    </FadeIn>
    
    <div class="max-w-2xl mx-auto mt-12">
      <!-- Contact Links -->
      <FadeIn delay={100}>
        <div class="grid sm:grid-cols-2 gap-4 mb-12">
          <a 
            href="mailto:adrian.wzorek@proton.me" 
            class="card p-6 text-center group hover:border-[var(--accent)]/50 transition-colors"
          >
            <div class="w-12 h-12 mx-auto mb-3 rounded-lg bg-[var(--accent)]/10 flex items-center justify-center group-hover:bg-[var(--accent)]/20 transition-colors">
              <svg class="w-6 h-6 text-[var(--accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <h3 class="font-display font-semibold mb-1">{emailLabel[lang]}</h3>
            <p class="text-[var(--text)]/70 text-sm break-all">adrian.wzorek@proton.me</p>
          </a>
          
          <a 
            href="https://www.linkedin.com/in/adrian-wzorek-902572309/" 
            target="_blank" 
            rel="noopener noreferrer"
            class="card p-6 text-center group hover:border-[var(--accent)]/50 transition-colors"
          >
            <div class="w-12 h-12 mx-auto mb-3 rounded-lg bg-[var(--accent)]/10 flex items-center justify-center group-hover:bg-[var(--accent)]/20 transition-colors">
              <svg class="w-6 h-6 text-[var(--accent)]" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </div>
            <h3 class="font-display font-semibold mb-1">{linkedinLabel[lang]}</h3>
            <p class="text-[var(--text)]/70 text-sm">adrian-wzorek-902572309</p>
          </a>
          
          <a 
            href="https://github.com/aszlaczek" 
            target="_blank" 
            rel="noopener noreferrer"
            class="card p-6 text-center group hover:border-[var(--accent)]/50 transition-colors"
          >
            <div class="w-12 h-12 mx-auto mb-3 rounded-lg bg-[var(--accent)]/10 flex items-center justify-center group-hover:bg-[var(--accent)]/20 transition-colors">
              <svg class="w-6 h-6 text-[var(--accent)]" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z" fill-rule="evenodd"/>
              </svg>
            </div>
            <h3 class="font-display font-semibold mb-1">{githubLabel[lang]}</h3>
            <p class="text-[var(--text)]/70 text-sm">aszlaczek</p>
          </a>
          
          <a 
            href="/portfolio/assets/Adrian_Wzorek_CV_pl.pdf" 
            download="Adrian_Wzorek_CV_pl.pdf"
            class="card p-6 text-center group hover:border-[var(--accent)]/50 transition-colors"
          >
            <div class="w-12 h-12 mx-auto mb-3 rounded-lg bg-[var(--accent)]/10 flex items-center justify-center group-hover:bg-[var(--accent)]/20 transition-colors">
              <svg class="w-6 h-6 text-[var(--accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
              </svg>
            </div>
            <h3 class="font-display font-semibold mb-1">{cvLabel[lang]}</h3>
            <p class="text-[var(--text)]/60 text-sm">{cvDesc[lang]}</p>
          </a>
        </div>
      </FadeIn>
      
      <!-- Direct contact -->
      <FadeIn delay={200} class="text-center">
        <p class="text-[var(--text)]/60 mb-4">{writeToMe[lang]}</p>
        <a 
          href="mailto:adrian.wzorek@proton.me" 
          class="btn btn-primary inline-flex items-center gap-2"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          {writeToMe[lang]}
        </a>
      </FadeIn>
    </div>
  </div>
</section>