---
import FadeIn from './FadeIn.tsx';
import ExperienceCard from './ExperienceCard.astro';
import { experiences } from '../data/experience';

interface Props {
  lang: 'pl' | 'en';
}

const { lang } = Astro.props;

const title = { pl: 'Doświadczenie', en: 'Experience' };
const subtitle = {
  pl: 'Mój ścieżka zawodowa i kluczowe osiągnięcia',
  en: 'My career path and key achievements'
};
---

<section id="experience" class="section" aria-labelledby="experience-title">
  <div class="container mx-auto px-4">
    <FadeIn class="max-w-3xl mx-auto text-center">
      <h2 id="experience-title" class="section-title">{title[lang]}</h2>
      <p class="text-[var(--text)]/60 mt-2">{subtitle[lang]}</p>
    </FadeIn>
    
    <div class="max-w-3xl mx-auto mt-12 space-y-6">
      {experiences.map((exp, index) => (
        <FadeIn delay={index * 150}>
          <ExperienceCard experience={exp} lang={lang} />
        </FadeIn>
      ))}
    </div>
    
    <!-- Illustration placeholder -->
    <div class="mt-12 lg:hidden">
      <FadeIn delay={300}>
        <img 
          src="/portfolio/assets/experience-placeholder.svg" 
          alt="" 
          aria-hidden="true"
          class="mx-auto max-w-xs opacity-50"
        />
      </FadeIn>
    </div>
  </div>
</section>