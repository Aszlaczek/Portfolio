---
interface Props {
  project: {
    slug: string;
    title: { pl: string; en: string };
    description: { pl: string; en: string };
    stack: string[];
    liveUrl: string;
    repoUrl: string;
    image: string;
  };
  lang: 'pl' | 'en';
}

const { project, lang } = Astro.props;
const t = project;

const caseStudyUrl = `/portfolio/${lang === 'en' ? 'en/' : ''}projects/${project.slug}${lang === 'en' ? '_en' : ''}/`;

const labels = {
  pl: { caseStudy: 'Case Study', live: 'Demo', code: 'Kod' },
  en: { caseStudy: 'Case Study', live: 'Live Demo', code: 'Code' }
};

const l = labels[lang];
---

<article class="card p-0 overflow-hidden group relative" aria-labelledby={`project-${project.slug}-title`}>
  <!-- Project Image -->
  <div class="aspect-video relative overflow-hidden bg-[var(--border)]">
    <img 
      src={project.image} 
      alt="" 
      aria-hidden="true"
      loading="lazy"
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
      onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
    />
    <!-- Fallback placeholder -->
    <div class="absolute inset-0 flex items-center justify-center bg-[var(--border)] text-[var(--text)]/30 hidden" aria-hidden="true">
      <svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
    </div>
  </div>
  
  <div class="p-6 space-y-4">
    <header>
      <h3 id={`project-${project.slug}-title`} class="font-display font-semibold text-xl group-hover:text-[var(--accent)] transition-colors">
        {t.title[lang]}
      </h3>
    </header>
    
    <p class="text-[var(--text)]/70 text-sm leading-relaxed">{t.description[lang]}</p>
    
    <!-- Stack -->
    <div class="flex flex-wrap gap-2" aria-label={lang === 'pl' ? 'Technologie' : 'Technologies'}>
      {t.stack.map(tech => (
        <span class="chip text-xs" key={tech}>{tech}</span>
      ))}
    </div>
    
    <!-- Links -->
    <div class="flex flex-wrap gap-3 pt-2 border-t border-[var(--border)]">
      <a 
        href={caseStudyUrl} 
        class="btn btn-primary text-sm flex-1 sm:flex-none"
        aria-label={`${l.caseStudy} ${t.title[lang]}`}
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        {l.caseStudy}
      </a>
      
      <a 
        href={t.liveUrl} 
        target="_blank" 
        rel="noopener noreferrer"
        class="btn btn-secondary text-sm flex-1 sm:flex-none"
        aria-label={`${l.live} ${t.title[lang]}`}
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
        {l.live}
      </a>
      
      <a 
        href={t.repoUrl} 
        target="_blank" 
        rel="noopener noreferrer"
        class="btn btn-secondary text-sm flex-1 sm:flex-none"
        aria-label={`${l.code} ${t.title[lang]}`}
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z" fill-rule="evenodd"/>
        </svg>
        {l.code}
      </a>
    </div>
  </div>
</article>