---
import FadeIn from './FadeIn.tsx';

interface Props {
  lang: 'pl' | 'en';
}

const { lang } = Astro.props;

const content = {
  pl: {
    title: 'O mnie',
    paragraphs: [
      'Ruch zawsze był moją pasją — w każdej formie. Od ponad pięciu lat jestem instruktorem karate, dzieląc się wiedzą i dyscypliną z uczniami w różnym wieku. Jako wychowawca na obozach sportowych pracowałem z różnorodnymi grupami, ucząc się precyzyjnego tłumaczenia zadań i dbania o to, by cel był jasny dla wszystkich.',
      'Te same zasady stosuję w programowaniu: precyzja, jasna komunikacja i silne przywództwo techniczne. Wierzę, że dobra aplikacja to taka, która rozwiązuje realny problem — nie lista technologii, tylko mierzalny efekt.',
      'Po godzinach kontynuuję rozwój: eksperymentuję z nowymi technologiami, buduję projekty open source i uczę się nowych wzorców architektonicznych. Karate nauczyło mnie cierpliwości i systematyczności — te same cechy pozwalają mi pisać czysty, utrzymywalny kod.'
    ]
  },
  en: {
    title: 'About Me',
    paragraphs: [
      'Movement has always been my passion — in every form. For over five years I\'ve been a karate instructor, sharing knowledge and discipline with students of all ages. As a camp counselor at sports camps, I worked with diverse groups, learning precise task communication and ensuring everyone understood the goal.',
      'I apply the same principles to programming: precision, clear communication, and strong technical leadership. I believe a good application solves a real problem — not a list of technologies, but measurable impact.',
      'After hours I continue growing: experimenting with new technologies, building open source projects, and learning new architectural patterns. Karate taught me patience and systematicity — the same traits help me write clean, maintainable code.'
    ]
  }
};

const t = content[lang];
---

<section id="about" class="section" aria-labelledby="about-title">
  <div class="container mx-auto px-4">
    <FadeIn class="max-w-3xl mx-auto text-center">
      <h2 id="about-title" class="section-title">{t.title}</h2>
    </FadeIn>
    
    <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto mt-12">
      {t.paragraphs.map((paragraph, index) => (
        <FadeIn delay={index * 150} class="text-left">
          <div class="card p-6 md:p-8">
            <p class="text-[var(--text)]/80 leading-relaxed">{paragraph}</p>
          </div>
        </FadeIn>
      ))}
    </div>
    
    <!-- Values / Approach -->
    <div class="mt-16">
      <FadeIn class="max-w-3xl mx-auto text-center">
        <h3 class="text-xl font-display font-semibold mb-6">
          {lang === 'pl' ? 'Moje podejście' : 'My Approach'}
        </h3>
      </FadeIn>
      
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-4xl mx-auto">
        {[
          { pl: 'Precyzja', en: 'Precision', desc: { pl: 'Każdy szczegół ma znaczenie', en: 'Every detail matters' } },
          { pl: 'Komunikacja', en: 'Communication', desc: { pl: 'Jasne przekazywanie intencji', en: 'Clear intent delivery' } },
          { pl: 'Wpływ', en: 'Impact', desc: { pl: 'Rozwiązania z efektem', en: 'Solutions with results' } },
          { pl: 'Rozwój', en: 'Growth', desc: { pl: 'Ciągła nauka', en: 'Continuous learning' } },
          { pl: 'Dyscyplina', en: 'Discipline', desc: { pl: 'Systematyczność w kodzie', en: 'Systematic code' } },
          { pl: 'Liderstwo', en: 'Leadership', desc: { pl: 'Przywództwo techniczne', en: 'Technical leadership' } }
        ].map((item, index) => (
          <FadeIn delay={index * 100} key={item.pl}>
            <div class="card p-6 text-center hover:border-[var(--accent)]/50 transition-colors">
              <h4 class="font-display font-semibold text-lg mb-2">{lang === 'pl' ? item.pl : item.en}</h4>
              <p class="text-[var(--text)]/60 text-sm">{lang === 'pl' ? item.desc.pl : item.desc.en}</p>
            </div>
          </FadeIn>
        ))}
      </div>
    </div>
  </div>
</section>